# pdf-to-ebook — machine settings.
#
# Copy to `.env` and edit. `.env` is gitignored; this file is the documented
# list and is not read by anything.
#
# Everything here is a *default*. A command-line flag beats it, and a real
# environment variable beats the file, so `--llm-model x` and
# `PDF_TO_EBOOK_LLM_MODEL=x pdf-to-ebook …` both still win. Nothing here is a
# secret: the whole pipeline is local, and there is no API key anywhere in it.
#
# `.env` is looked for at or above the working directory, so one at the repo
# root covers `cargo run` from any crate. `PDF_TO_EBOOK_ENV_FILE` names one
# outright.

# --- Proofreading ----------------------------------------------------------

# The ollama server, or a comma-separated list of them. Batches are pulled from
# a shared queue, so a faster box simply takes more of them; the same URL twice
# gives that server two workers. `host:port` gets the `http://` it meant.
# Falls back to OLLAMA_HOST, which is ollama's own variable.
PDF_TO_EBOOK_OLLAMA_URL=http://localhost:11434

# The model to proofread with. It must be pulled on every server in the list —
# preflight checks, and drops the ones that do not have it.
PDF_TO_EBOOK_LLM_MODEL=gemma4:e4b

# Where model replies are cached, keyed by model, prompt and paragraph, so a
# re-run of a long book costs nothing. Defaults to the OS cache directory
# (~/Library/Caches/pdf-to-ebook on macOS). `--no-cache` bypasses it for one
# run.
# PDF_TO_EBOOK_CACHE_DIR=/var/tmp/pdf-to-ebook

# Load the proofreading prompt from this directory instead of the compiled-in
# one. It is read per file, so a directory holding only `languages/nld.md`
# adds a Dutch pack and keeps the built-in general prompt. See `prompts/`.
# PDF_TO_EBOOK_PROMPT_DIR=./prompts

# --- Extraction ------------------------------------------------------------

# Default --lang: the tesseract code for the book's language. It also picks the
# prompt's language pack and the EPUB's language metadata.
PDF_TO_EBOOK_OCR_LANG=eng

# Default --dpi: what pages are rasterised at before OCR. Higher is slower and
# not always better; 300 is what the accuracy numbers in docs/findings.md were
# measured at.
PDF_TO_EBOOK_DPI=300

# --- External tools --------------------------------------------------------
#
# All optional, each needed for one path only. A born-digital PDF to EPUB needs
# none of them. Set these only when the tool is not on PATH.

# tesseract, for pages with no text layer.
# TESSERACT_BIN=/opt/homebrew/bin/tesseract

# calibre's ebook-convert, for MOBI and AZW3. On macOS it lives inside the app
# bundle and is not on PATH; that location is already checked, so this is only
# for an install somewhere unusual.
# EBOOK_CONVERT=/Applications/calibre.app/Contents/MacOS/ebook-convert
